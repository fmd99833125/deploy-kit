# ============================================================================
# deploy-kit · 项目注册表条目 —— xuexu（学序）
#
# 每个要发布到这台服务器的项目，在 projects.d/ 下放一份 <project>.env。
# 新增项目 = 复制这份文件改几个值 + 在服务器建对应目录。
# 完整接入说明见 deploy-kit/README.md。
#
# ⚠️ 这个文件会被 releaser.sh `source`，所以只放 KEY=VALUE，别放逻辑。
# ============================================================================

# 项目标识（用于锁文件名、镜像名、目录名）
PROJECT_NAME=xuexu

# ── 服务器上的位置 ─────────────────────────────────────────────────────────
# 代码仓（服务器只用来同步 git，实际构建在 CI）
REPO_DIR=/opt/learning/repo
# compose 与 Caddyfile 所在目录
DEPLOY_DIR=/opt/learning/repo/deploy
# 发布产物留存：releases/web/<sha>/ 保留最近 KEEP_RELEASES 个，供回滚
RELEASES_DIR=/opt/learning/releases
# CI 推来的原始产物：incoming/<sha>/{web-dist.tar.gz,api-image.tar.gz}
ARTIFACT_DIR=/opt/learning/incoming

# ── 发布内容 ───────────────────────────────────────────────────────────────
# 前端产物解包后要落到 DEPLOY_DIR 下的哪个子目录（当前 Caddy bind mount 的是 deploy/web）
WEB_SUBDIR=web
# 后端镜像名。CI 构建 <API_IMAGE>:<sha>，服务器 docker load 后打成 <API_IMAGE>:current
API_IMAGE=xuexu-api
# 健康检查要确认在跑的容器（空格分隔）
HEALTH_SERVICES="api worker caddy"
# 保留几个历史版本（回滚用）
KEEP_RELEASES=3
