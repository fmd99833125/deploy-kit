# deploy-kit 项目注册表 · kids
#
# 这份文件会被装到服务器的 /opt/deploy-kit/projects.d/kids.env
# releaser.sh / push-incoming.sh 都靠它知道这个项目的路径和镜像。

PROJECT_NAME=kids

# 代码仓在服务器上的位置
REPO_DIR=/opt/kids/repo
DEPLOY_DIR=/opt/kids/repo/deploy

# 版本留存（前端目录 + 当前版本号）
RELEASES_DIR=/opt/kids/releases

# CI 传产物的落地目录
ARTIFACT_DIR=/opt/kids/incoming

# 前端产物放在 deploy/ 下的哪个子目录（compose 里 bind mount 的那个）
WEB_SUBDIR=web

# 后端镜像。**显式留空 = 本项目没有后端镜像**（纯前端站），
# 不写这一行则默认用 <项目名>-api。
API_IMAGE=kids-api

# 换镜像后要重建的服务（跑业务代码的容器）
# ⚠️ 值必须加引号：这份文件会被 . (source) 进来，
#    不加引号时 "api caddy" 会被解析成两条赋值 —— 第二个词 caddy 会被当成命令执行。
APP_SERVICES=""

# 换前端后要重建的服务（bind mount 绑着 web 目录，必须重建才重新解析 inode）
WEB_SERVICES="api"

# 健康检查看哪些服务：全部 running/healthy 才算发布成功
HEALTH_SERVICES="api"

# 保留最近几个版本（其余的会被清理）
KEEP_RELEASES=3
